{
  "manifest_version": 3,
  "name": "ylang",
  "description": "Local-first dual subtitles and sentence mining for language learning.",
  "version": "0.1.0",
  "icons": {
    "16": "assets/icons/ylang-16.png",
    "32": "assets/icons/ylang-32.png",
    "48": "assets/icons/ylang-48.png",
    "128": "assets/icons/ylang-128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/icons/ylang-16.png",
      "32": "assets/icons/ylang-32.png",
      "48": "assets/icons/ylang-48.png",
      "128": "assets/icons/ylang-128.png"
    },
    "default_popup": "src/extension/popup/index.html",
    "default_title": "ylang"
  },
  "options_page": "src/extension/options/index.html",
  "permissions": ["storage", "tabs", "system.display"],
  "host_permissions": [
    "https://tv.nrk.no/*",
    "https://www.youtube.com/*",
    "https://www.netflix.com/*",
    "file:///*",
    "https://www.deepl.com/*",
    "https://api.cognitive.microsofttranslator.com/*",
    "https://psapi.nrk.no/*",
    "https://undertekst.nrk.no/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://tv.nrk.no/*", "https://www.netflix.com/*", "https://www.youtube.com/watch*"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "exclude_matches": ["https://www.deepl.com/*", "https://deepl.com/*", "https://tv.nrk.no/*", "https://www.netflix.com/*", "https://www.youtube.com/watch*"],
      "js": ["assets/reading.js"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.deepl.com/translator*", "https://www.deepl.com/*/translator*"],
      "js": ["assets/deepl.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/icons/ylang.svg", "assets/icons/ylang.webp", "assets/icons/ylang-16.png", "assets/icons/ylang-32.png", "assets/icons/ylang-48.png", "assets/icons/ylang-128.png"],
      "matches": ["http://*/*", "https://*/*", "file:///*"]
    }
  ]
}
